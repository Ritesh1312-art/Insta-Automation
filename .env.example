# Put these in Cloudflare Workers → Settings → Variables and Secrets
# (Build variables AND runtime secrets). Do not commit real keys.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/instagram_automation?schema=public"
APP_URL="https://instadm-auto.YOUR_SUBDOMAIN.workers.dev"
AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
ENCRYPTION_KEY="generate-a-64-character-hex-key"
CRON_SECRET="generate-a-random-secret-for-vercel-cron"
SETUP_TOKEN="generate-a-one-time-administrator-setup-token"

META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_VERIFY_TOKEN="generate-a-random-webhook-verify-token"
META_GRAPH_API_VERSION="v21.0"
META_REDIRECT_URI="https://your-domain.example/api/auth/meta/callback"

UPI_ID="yourname@okaxis"
UPI_PAYEE_NAME="Your Legal Name"
UPI_NOTE="InstaDM plan payment"

# Optional. Direct UPI is the default checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
