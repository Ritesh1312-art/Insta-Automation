# Cloudflare/Vercel settings. Keep real values in deployment secrets, never Git.

# --- Required account-owned values ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/instagram_automation?schema=public"
APP_URL="https://instadm-auto.example.com"
META_APP_ID="from Meta Developers"
META_APP_SECRET="from Meta Developers"
UPI_ID="name@okaxis"
UPI_PAYEE_NAME="Name as shown on the UPI bank profile"

# --- Required generated secrets ---
AUTH_SECRET="at-least-32-random-characters"
ENCRYPTION_KEY="64-character-hex-string"
CRON_SECRET="random-string-for-the-retry-job"
SETUP_TOKEN="one-time-admin-setup-token"
META_VERIFY_TOKEN="random-webhook-verify-token"

META_GRAPH_API_VERSION="v21.0"
META_REDIRECT_URI="https://instadm-auto.example.com/api/auth/meta/callback"
UPI_NOTE="InstaDM plan payment"

# --- Optional: Telegram payment approval bot ---
# Environment values override settings saved from the admin dashboard.
# Do NOT add TELEGRAM_WEBHOOK_SECRET; the app derives it from AUTH_SECRET.
# TELEGRAM_BOT_TOKEN="BotFather token"
# TELEGRAM_CHAT_ID="numeric admin chat ID"

# --- Optional: transactional mail (all five are needed to send) ---
# Gmail: use an App Password, not the normal account password.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="16-character Gmail App Password"
# SMTP_FROM="InstaDM Auto <you@gmail.com>"

# --- Optional: pin one Facebook Page when a Meta account has several ---
# META_FACEBOOK_PAGE_ID=""
