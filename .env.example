# Cloudflare Workers → Settings → Variables and Secrets
# Add every key to BOTH Build variables and Runtime secrets.

# --- You must paste these from your own accounts ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/instagram_automation?schema=public"
APP_URL="https://instadm-auto.YOUR_SUBDOMAIN.workers.dev"
META_APP_ID="from Meta Developers → App ID"
META_APP_SECRET="from Meta Developers → App Secret"
UPI_ID="name@okaxis"
# Use the name printed on your UPI / bank profile for this VPA.
# Random text often still pays, but GPay/PhonePe can show a name-mismatch warning.
UPI_PAYEE_NAME="Name as on your UPI app"

# --- Generate once (openssl / the values in your private .env) ---
AUTH_SECRET="at-least-32-random-characters"
ENCRYPTION_KEY="64-character-hex-string"
CRON_SECRET="random-string-for-the-retry-job"
SETUP_TOKEN="one-time-admin-setup-token"
META_VERIFY_TOKEN="random-webhook-verify-token"

META_GRAPH_API_VERSION="v21.0"
META_REDIRECT_URI="https://instadm-auto.YOUR_SUBDOMAIN.workers.dev/api/auth/meta/callback"
UPI_NOTE="InstaDM plan payment"

# --- Optional: email OTP for password reset (forgot password page) ---
# Without SMTP_USER / SMTP_PASSWORD the OTP email is skipped gracefully.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char App Password>
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""

# --- Optional: pin one Facebook Page when a Meta account has several ---
# META_FACEBOOK_PAGE_ID=""

# --- Optional: Razorpay gateway (Direct UPI checkout works without these) ---
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# Optional Razorpay plan ids for recurring subscriptions (per plan)
# RAZORPAY_PLAN_STANDARD=""
# RAZORPAY_PLAN_PREMIUM=""
# RAZORPAY_PLAN_PREMIUM_PRO=""
# RAZORPAY_PLAN_PREMIUM_PRO_PLUS=""
