{
  "name": "instagram-comment-dm-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "admin:create": "tsx scripts/create-admin.ts",
    "cf:build": "node scripts/prisma-generate.mjs && npx --yes @opennextjs/cloudflare@1.20.6 build",
    "cf:deploy": "npm run cf:build && npx --yes wrangler@latest deploy",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:deploy": "node scripts/db-deploy.mjs",
    "env:check": "node scripts/check-env.mjs",
    "test:unit": "vitest run",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "db:local": "node scripts/db-local.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.16.3",
    "@prisma/client": "6.16.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "jose": "^5.2.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "nodemailer": "10.0.12",
    "pg": "8.16.3",
    "pg-cloudflare": "1.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "^17.10.0-beta.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.19.3",
    "@types/pg": "8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "^10.4.17",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "6.16.3",
    "smtp-server": "^3.19.17",
    "tailwindcss": "^3.4.1",
    "tsx": "4.20.6",
    "typescript": "^5.3.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "sharp": "0.35.5",
    "deepmerge-ts": "8.0.2",
    "effect": "3.20.0"
  }
}
