{
  "name": "instagram-comment-dm-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx --yes prisma@5.22.0 generate && npx --yes prisma@5.22.0 db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "admin:create": "node scripts/create-admin.mjs",
    "cf:build": "prisma generate && prisma db push --accept-data-loss && npx --yes @opennextjs/cloudflare build",
    "cf:deploy": "npm run cf:build && npx --yes wrangler deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@types/nodemailer": "^8.0.1",
    "@vercel/functions": "^2.2.13",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "jose": "^5.2.2",
    "lucide-react": "^0.330.0",
    "next": "15.5.21",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.17",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.2"
  }
}
