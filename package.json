{
  "name": "instagram-comment-dm-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm audit --omit=dev --audit-level=high",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run check && npm run db:deploy && npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.0",
    "jose": "5.10.0",
    "lucide-react": "0.330.0",
    "next": "15.5.26",
    "nodemailer": "10.0.12",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.6.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "type": "module"
}
